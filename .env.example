# Port the site is served on (http://<truenas-ip>:8080)
FRONTEND_PORT=8080

# Where the SQLite database and uploaded photographs live.
# On TrueNAS point this at a dataset so snapshots/backups cover your data:
#   DATA_DIR=/mnt/tank/family-tree/data
DATA_DIR=./data

# Admin login — change these before exposing the site
SECRET_KEY=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Shown in the header and the browser tab
SITE_TITLE=Our Family Tree

# Set to true to seed a small example family on first start.
# Delete the example people from the admin panel once you are ready.
SEED_DEMO_DATA=false

# Max size for a single uploaded photograph, in bytes (default 25 MB)
MAX_UPLOAD_BYTES=26214400
